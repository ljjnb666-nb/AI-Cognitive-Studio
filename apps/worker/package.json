    ,"test:phase4:e2e": "vitest run --config vitest.phase4-e2e.config.ts",
    "test:phase5:e2e": "vitest run --config vitest.phase5-e2e.config.ts",
    "test:phase8c:production": "vitest run --config vitest.integration.config.ts tests/phase8c-production-runtime.test.ts",
    "test:phase8c:podcast-gateway": "vitest run --config vitest.integration.config.ts tests/phase8c-podcast-gateway-runtime.test.ts",
    "test:phase8c:podcast-autonomy": "vitest run --config vitest.integration.config.ts tests/phase8c-podcast-gateway-runtime.test.ts"
