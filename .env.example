## The repository-root .env is the single local-development environment file
## for pnpm dev, pnpm dev:web, pnpm dev:worker, and Prisma commands.
NODE_ENV=development
# Required in every environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required canonical URL for auth cookies, redirects, and callback validation.
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated exact browser origins. In development localhost is added automatically.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001
WEB_DEV_BOOTSTRAP_IDENTITY=true
WEB_DEV_BOOTSTRAP_EMAIL=local-product@ai-cognitive-studio.test
# Closed Beta product access. OFF preserves normal authenticated Studio behavior.
BETA_ACCESS_MODE=OFF
# Development/test only. Bootstrap creates only the stable User, Workspace,
# and WorkspaceMember container; production requires an upstream verified identity.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/ai_cognitive_studio?schema=public
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/ai_cognitive_studio_test?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-cognitive-studio-dev
S3_ACCESS_KEY=local-development-only
S3_SECRET_KEY=local-development-only
S3_FORCE_PATH_STYLE=true
SOURCE_UPLOAD_URL_TTL_SECONDS=900
SOURCE_UPLOAD_COMPLETION_LEASE_MS=900000
SOURCE_OUTBOX_LEASE_MS=60000
SOURCE_OUTBOX_MAX_ATTEMPTS=5
# Explicit, bounded BullMQ worker and outbox dispatcher concurrency (1-32).
WORKER_INGESTION_CONCURRENCY=1
WORKER_BOOK_ANALYSIS_CONCURRENCY=1
WORKER_PODCAST_GENERATION_CONCURRENCY=1
WORKER_AUDIO_CONCURRENCY=1
WORKER_SHORT_VIDEO_CONCURRENCY=1
OUTBOX_DISPATCH_CONCURRENCY=1
SOURCE_MAX_UPLOAD_BYTES=104857600
SOURCE_MAX_PDF_PAGES=2000
SOURCE_PARSE_TIMEOUT_MS=120000
# Required when Provider Gateway workspace credentials or durable EMBEDDING execution are used. JSON shape:
# {"activeVersion":"v1","keys":{"v1":"base64-encoded-32-byte-key"}}
# Never generate this automatically and never commit a real key.
PROVIDER_GATEWAY_KEYRING=
# Required for workspace BYOK route validation. JSON shape is a server-only
# manifest of provider capabilities; do not put API credentials in it.
# {"providers":[{"providerKey":"openai","displayName":"OpenAI","protocol":"OPENAI_RESPONSES","capabilityProtocols":{"EMBEDDING":"OPENAI_EMBEDDINGS","SPEECH":"CUSTOM_SPEECH"},"adapterVersion":"v1","models":[{"modelId":"example","families":["TEXT_GENERATION"],"confidence":"DECLARED","structuredOutput":"JSON_MODE"}]}]}
PROVIDER_GATEWAY_MODEL_MANIFEST=
# Legacy process-level enablement only. These values never determine a new
# workspace run provider/model; configure each workspace at /studio/settings/providers.
BOOK_ANALYSIS_PROVIDER=
PODCAST_GENERATION_PROVIDER=
AUDIO_GENERATION_PROVIDER=
SHORT_VIDEO_GENERATION_PROVIDER=
ALLOW_PRIVATE_PROVIDER_ENDPOINTS=false
