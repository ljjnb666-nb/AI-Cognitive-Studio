{
  "name": "@ai-cognitive/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma": "prisma",
    "prisma:generate:root": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate:root": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy:root": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:studio:root": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.1",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
