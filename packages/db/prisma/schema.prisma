  @@unique([uploadSessionId, workspaceId])
  @@unique([sourceDocumentId, workspaceId])
}

model IngestionRun {
  id                    String                 @id @default(cuid())
  sourceDocumentId      String
  workspaceId           String
  jobId                 String                 @unique
  status                IngestionStatus        @default(QUEUED)
  /// Planned/initial parser provenance written before any parser runs (upload
  /// completion). NOT the parser authority: the durable authority is
  /// DocumentExtraction plus per-block SourceBlock provenance metadata.
  parserVersion         String
  normalizationVersion  String
  errorCode             String?
  /// Execution claim fence (BOOK-INGESTION-04B-1). PostgreSQL is the sole
  /// execution authority; BullMQ only schedules deliveries. A run may execute
  /// work only while status = RUNNING, executionClaimToken matches the live
  /// owner and executionLeaseUntil > NOW().
  executionClaimToken   String?
  executionClaimedAt    DateTime?
  executionLeaseUntil   DateTime?
  /// Routing durability (write-once plan, one-way terminal outcome). No
  /// routing behavior until BOOK-INGESTION-04B-2; historical rows keep NULL.
  routingGeneration     Int?
  routingPlan           Json?
  routingOutcome        Json?
  createdAt             DateTime               @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  sourceDocument        SourceDocument         @relation(fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  job                   Job                    @relation(fields: [jobId], references: [id], onDelete: Restrict)
  extraction            DocumentExtraction?
  bookAnalysisBootstrap BookAnalysisBootstrap?
  ocrPageAttempts       OcrPageAttempt[]
  ocrServerInstances    OcrServerInstance[]

  @@unique([id, sourceDocumentId, workspaceId])
  @@index([executionLeaseUntil])
}

/// Current per-host OCR machine-capacity authority (fenced lease). Deliberately
/// NOT server identity/history: detached server instances live in
/// OcrServerInstance so stale-owner evidence survives lease reclaims.
model OcrHostLease {
  hostId       String    @id
  /// NULL = the slot is free (released); a live owner always has a token.
  claimToken   String?
  claimedAt    DateTime?
  leaseUntil   DateTime?
  hostMetadata Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leaseUntil])
}

/// Authoritative PAGE CHECKPOINT row for OCR execution — one row per
/// (ingestion run, physical page, routing generation); attemptCount counts
/// execution attempts on the row. Raw per-execution history belongs to
/// immutable artifacts/logs, not extra rows. Workspace/source lineage columns
/// exist so every relation and write predicate fails closed across tenant
/// boundaries.
model OcrPageAttempt {
  id                       String               @id @default(cuid())
  workspaceId              String
  sourceDocumentId         String
  ingestionRunId           String
  physicalPageIndex        Int
  routingGeneration        Int
  status                   OcrPageAttemptStatus @default(PENDING)
  claimToken               String?
  claimedAt                DateTime?
  leaseUntil               DateTime?
  attemptCount             Int                  @default(0)
  nextAttemptAt            DateTime?
  parserName               String?
  parserVersion            String?
  parserMode               String?
  modelRevision            String?
  errorCode                String?
  durationMs               Int?
  authoritativeArtifactKey String?
  textSha256               String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  ingestionRun             IngestionRun         @relation(fields: [ingestionRunId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Cascade)

  @@unique([ingestionRunId, physicalPageIndex, routingGeneration])
  @@index([ingestionRunId, routingGeneration])
  @@index([status, nextAttemptAt])
  @@index([workspaceId])
}

/// Durable identity/history for detached MinerU server instances. One row
/// forever belongs to ONE hostClaimToken; reclaiming the mutable OcrHostLease
/// never overwrites or erases a prior owner's instance evidence.
model OcrServerInstance {
  id                String                  @id @default(cuid())
  workspaceId       String
  sourceDocumentId  String
  ingestionRunId    String
  hostId            String
  hostClaimToken    String                  @unique
  runExecutionToken String
  mineruHome        String
  pid               Int?
  serverId          String?
  transports        Json?
  status            OcrServerInstanceStatus @default(STARTING)
  startedAt         DateTime?
  stoppedAt         DateTime?
  lastObservedAt    DateTime?
  terminationReason String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  ingestionRun      IngestionRun            @relation(fields: [ingestionRunId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Cascade)

  @@index([hostId, status])
  @@index([workspaceId])
}

model DocumentExtraction {
  id                     String                     @id @default(cuid())
  ingestionRunId         String                     @unique
  sourceDocumentId       String
  workspaceId            String
  status                 ExtractionStatus
  parserName             String
  parserVersion          String
  normalizationVersion   String
  /// NULL for extractions created before the canonical contract
  /// (canonical-book-v1); never backfilled.
  canonicalSchemaVersion String?
  /// Quality contract semantics: NULL = legacy extraction without the
  /// canonical quality contract; UNKNOWN = canonical-book-v1 extraction not
  /// yet assessed by a production quality gate (parser success is never
  /// acceptance); ACCEPTED/DEGRADED/REQUIRES_FALLBACK/REJECTED are reserved
  /// for that future gate. Never backfilled.
  qualityStatus          ExtractionQualityStatus?
  qualityMetadata        Json?
  /// Format-native extraction metadata (canonical-book-v1, additive). NULL =
  /// legacy rows and non-EPUB formats (PDF/TXT/Markdown); EPUB extractions
  /// persist the validated EpubExtractionMetadata contract. Never backfilled.
  formatMetadata           Json?
  /// Immutable product-identity candidate evidence derived from this exact
  /// extraction. NULL = legacy/non-EPUB. This is evidence-only and never
  /// authorizes ingestion to overwrite Work/Edition product identity.
  productIdentityCandidate Json?
  textStorageKey           String?
  textSha256             String?
  characterCount         Int?
  createdAt              DateTime                   @default(now())
  ingestionRun           IngestionRun               @relation(fields: [ingestionRunId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Cascade)
  sourceDocument         SourceDocument             @relation("DocumentExtractionSourceDocument", fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  currentMarker          CurrentDocumentExtraction? @relation("CurrentExtractionDocument")
  pages                  SourcePage[]
  blocks                 SourceBlock[]
  structureNodes         DocumentStructureNode[]
  chunkSets              ChunkSet[]
  analysisRuns           BookAnalysisRun[]
  bookAnalysisBootstraps BookAnalysisBootstrap[]
  productIdentityPromotion ProductIdentityPromotion?

  @@unique([id, sourceDocumentId, workspaceId])
  @@unique([ingestionRunId, sourceDocumentId, workspaceId])
}

model ProductIdentityPromotion {
