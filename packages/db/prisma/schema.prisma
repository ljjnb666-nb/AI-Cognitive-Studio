  sha256               String
  format               String
  mediaType            String
  durationMs           Int
  status               AudioArtifactStatus   @default(SUCCEEDED)
  createdAt            DateTime              @default(now())
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  episode              PodcastEpisode        @relation(fields: [episodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  scriptRevision       PodcastScriptRevision @relation(fields: [scriptRevisionId, workspaceId, episodeId], references: [id, workspaceId, episodeId], onDelete: Restrict)
  run                  AudioGenerationRun    @relation(fields: [audioGenerationRunId, workspaceId, episodeId], references: [id, workspaceId, episodeId], onDelete: Restrict)
  currentMarker        CurrentPodcastAudio?  @relation("CurrentPodcastAudioRevision")
  @@unique([episodeId, revisionNumber])
  @@unique([id, workspaceId, episodeId])
}

model CurrentPodcastAudio {
  id          String               @id @default(cuid())
  workspaceId String
  episodeId   String               @unique
  revisionId  String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  episode     PodcastEpisode       @relation(fields: [episodeId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  revision    PodcastAudioRevision @relation("CurrentPodcastAudioRevision", fields: [revisionId, workspaceId, episodeId], references: [id, workspaceId, episodeId], onDelete: Restrict)
  @@unique([episodeId, workspaceId])
  @@unique([revisionId, workspaceId, episodeId])
}

model AudioEvaluationRun {
  id                   String             @id @default(cuid())
  audioGenerationRunId String
  workspaceId          String
  episodeId            String
  evaluatorVersion     String
  status               AudioArtifactStatus @default(PENDING)
  errorCode            String?
  createdAt            DateTime           @default(now())
  completedAt          DateTime?
  run                  AudioGenerationRun @relation(fields: [audioGenerationRunId, workspaceId, episodeId], references: [id, workspaceId, episodeId], onDelete: Cascade)
  result               AudioEvaluationResult?
  @@unique([audioGenerationRunId, evaluatorVersion])
}

model AudioEvaluationResult {
  id                      String             @id @default(cuid())
  evaluationRunId         String             @unique
  metrics                 Json
  hardFailures            Json
  warnings                Json
  decodeSuccess           Boolean
  durationDriftRatio      Float
  silenceRatio            Float
  maxSilenceGapMs         Int
  averageGapMs            Int
  hostVoiceDistinctness   Boolean
  createdAt               DateTime           @default(now())
  evaluationRun           AudioEvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id           String       @id @default(cuid())
  topic        String
  aggregateId  String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attemptCount Int          @default(0)
  claimedAt    DateTime?
  leaseUntil   DateTime?
  lastError    String?
  claimToken   String?
  createdAt    DateTime     @default(now())
  dispatchedAt DateTime?
  updatedAt    DateTime     @updatedAt

  @@index([dispatchedAt, createdAt])
  @@index([status, leaseUntil, createdAt])
}

model Job {
  id                   String                @id @default(cuid())
  userId               String?
  workspaceId          String?
  queueJobId           String?               @unique
  idempotencyKey       String?               @unique
  correlationId        String?
  type                 String
  status               JobStatus             @default(QUEUED)
  progress             Int                   @default(0)
  attemptCount         Int                   @default(0)
  payload              Json
  result               Json?
  error                Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  startedAt            DateTime?
  completedAt          DateTime?
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ingestionRun         IngestionRun?
  bookAnalysisRun      BookAnalysisRun?
  podcastGenerationRun PodcastGenerationRun?
  audioGenerationRun   AudioGenerationRun?

  @@index([userId])
  @@index([status])
  @@index([correlationId])
  @@index([workspaceId, status])
}
