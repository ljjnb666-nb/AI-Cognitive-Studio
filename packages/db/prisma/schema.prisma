generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProviderConnectionStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum ProviderConnectionHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  RATE_LIMITED
  AUTH_FAILED
}

enum ProviderCredentialStatus {
  ACTIVE
  RETIRED
  REVOKED
}

enum ProviderInvocationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
  RECONCILIATION_REQUIRED
}

enum ProviderInvocationAttemptStatus {
  RUNNING
  SUCCEEDED
  REMOTE_FAILURE
  TIMEOUT
  CANCELLED_AFTER_REQUEST
  REMOTE_OUTCOME_UNKNOWN
}

enum ProviderOutcomeRecoveryCapability {
  NONE
  AUTHORITATIVE_LOOKUP
  PROVIDER_IDEMPOTENT_REPLAY
  ASYNC_OPERATION_HANDLE
}

enum PodcastAudioPaidOutcomeQuarantineStatus {
  OPEN
  RESOLVED
}

enum PodcastAudioPaidOutcomeResolution {
  DEFINITIVE_REMOTE_FAILURE
  ABANDON_AND_ALLOW_RETRY
}

enum ProviderUsageStatus {
  SUCCEEDED
  FAILED
}

enum ProviderAuditAction {
  CONNECTION_CREATED
  CONNECTION_UPDATED
  CONNECTION_DISABLED
  CONNECTION_ENABLED
  CREDENTIAL_CREATED
  CREDENTIAL_ROTATED
  CREDENTIAL_REVOKED
  ROUTING_UPDATED
}

enum SourceKind {
  FILE
  URL
  NOTE
  TRANSCRIPT
}

enum UploadSessionStatus {
  CREATED
  UPLOADED
  COMPLETING
  COMPLETED
  EXPIRED
  REJECTED
}

enum IngestionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
  OCR_REQUIRED
  PASSWORD_REQUIRED
}

/// Durable OCR page checkpoint state (BOOK-INGESTION-04B-1; consumed by 04B-2+).
/// One checkpoint row per (run, physical page, routing generation).
enum OcrPageAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Durable detached MinerU server instance identity. STARTING is persistable
/// BEFORE process launch, so endpoint identity fields stay nullable; the
/// service layer (not Prisma) enforces endpoint presence for RUNNING/STOPPING.
enum OcrServerInstanceStatus {
  STARTING
  RUNNING
  STOPPING
  STOPPED
  ORPHANED
}

enum ExtractionStatus {
  SUCCEEDED
  FAILED
  OCR_REQUIRED
}

/// Durable extraction quality state. Historical extractions keep NULL;
/// never backfill.
enum ExtractionQualityStatus {
  UNKNOWN
  ACCEPTED
  DEGRADED
  REQUIRES_FALLBACK
  REJECTED
}

/// Durable result of a controlled product-identity promotion attempt.
enum ProductIdentityPromotionStatus {
  APPLIED
  NOOP
  CONFLICT
  BLOCKED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
}

enum SourceBlockKind {
  HEADING
  PARAGRAPH
  LIST_ITEM
  QUOTE
  TABLE
  IMAGE
  CAPTION
  FOOTNOTE
  CODE
  EQUATION
  UNKNOWN
}

enum ChunkSetStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum BookAnalysisBootstrapStatus {
  PENDING
  RUNNING
  WAITING_FOR_PROVIDER
  SUCCEEDED
  FAILED_TERMINAL
}

enum StructureNodeKind {
  ROOT
  CHAPTER
  SECTION
  SUBSECTION
  STRUCTURAL_GROUP
  PAGE_GROUP
}

enum AnalysisScope {
  CHUNK
  SECTION
  CHAPTER
  BOOK
}

enum AnalysisRunStage {
  QUEUED
  CHUNK_ANALYSIS
  SECTION_ANALYSIS
  CHAPTER_ANALYSIS
  BOOK_SYNTHESIS
  MEMORY_FINALIZATION
  EMBEDDINGS
  FINALIZING
  COMPLETED
}

enum BookMemoryItemType {
  SUMMARY
  CONCEPT
  ARGUMENT
  CLAIM
  EXAMPLE
  STORY
  QUOTE
  PERSON
  QUESTION
  COUNTERPOINT
  RELATION
}

enum BookMemoryRelationType {
  EXPLAINS
  SUPPORTS
  OPPOSES
  ASSOCIATED_WITH
  DEVELOPS
}

enum UserCognitionStateKind {
  SAVED
  ARCHIVED
}

enum ThinkingSessionStatus {
  ACTIVE
  COMPLETED
}

enum ThinkingSessionMessageRole {
  USER
  ASSISTANT
}

enum TeachBackAttemptStatus {
  PENDING_ASSESSMENT
  ASSESSED
}

enum TeachBackMasteryState {
  NEEDS_REVIEW
  DEVELOPING
  DEMONSTRATED
}

enum UserCognitionReviewEventKind {
  MANUAL_REVIEW
}

enum PodcastEpisodeStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum PodcastGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum PodcastGenerationStage {
  QUEUED
  EPISODE_PLANNING
  NARRATIVE_DESIGN
  SEGMENT_OUTLINE
  SEGMENT_DRAFTING
  HUMANIZATION
  GROUNDING_VALIDATION
  FINALIZING
  COMPLETED
}

enum PodcastSegmentStatus {
  PLANNED
  DRAFTED
  HUMANIZED
  GROUNDED
}

enum PodcastUtteranceType {
  STATEMENT
  QUESTION
  REACTION
  CHALLENGE
  CLARIFICATION
  EXAMPLE
  TRANSITION
  CALLBACK
}

enum PodcastRevisionSource {
  GENERATED
  REGENERATED
  USER_EDIT
}

enum PodcastRevisionStatus {
  FINAL
  SUPERSEDED
}

enum PodcastEvaluationStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AudioGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AudioGenerationStage {
  QUEUED
  SPEECH_PREPARATION
  UTTERANCE_SYNTHESIS
  SEGMENT_ASSEMBLY
  EPISODE_ASSEMBLY
  AUDIO_NORMALIZATION
  QUALITY_VALIDATION
  FINALIZING
  COMPLETED
}

enum AudioArtifactStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ShortVideoGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ShortVideoGenerationStage {
  QUEUED
  CONTEXT_RETRIEVAL
  VIDEO_PLANNING
  NARRATIVE_GENERATION
  SCENE_PLANNING
  NARRATION_SYNTHESIS
  VISUAL_PREPARATION
  CAPTION_GENERATION
  VIDEO_RENDERING
  QUALITY_VALIDATION
  FINALIZING
  COMPLETED
}

enum ShortVideoSceneType {
  HOOK
  QUESTION
  CLAIM
  CONTRAST
  EVIDENCE
  QUOTE
  CONCEPT
  LIST
  DIAGRAM
  REFRAME
  CALLBACK
  ENDING
}

enum BetaParticipantRole {
  TESTER
  OPERATOR
}

enum BetaParticipantStatus {
  ACTIVE
  WITHDRAWN
  REMOVED
}

enum BetaFeedbackCategory {
  BUG
  CONFUSION
  QUALITY
  FEATURE
  OTHER
}

enum BetaFeedbackDimension {
  OVERALL
  PODCAST_NATURALNESS
  PODCAST_VALUE
  COGNITION_VALUE
  USABILITY
}

enum BetaFeedbackStatus {
  NEW
  REVIEWED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  avatarUrl           String?
  emailVerified       Boolean              @default(false)
  image               String?
  defaultWorkspaceId  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  jobs                Job[]
  memberships         WorkspaceMember[]
  accounts            Account[]
  sessions            Session[]
  cognitionStates     UserCognitionState[]
  defaultWorkspace    Workspace?           @relation("DefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  betaParticipant     BetaParticipant?
  redeemedBetaInvites BetaInvite[]         @relation("BetaInviteRedeemer")
  productEvents       ProductEvent[]

  @@index([defaultWorkspaceId])
}

model Workspace {
  id                                 String                              @id @default(cuid())
  name                               String
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  members                            WorkspaceMember[]
  projects                           Project[]
  works                              Work[]
  sources                            Source[]
  sourceBlobs                        SourceBlob[]
  uploadSessions                     UploadSession[]
  jobs                               Job[]
  chunkSets                          ChunkSet[]
  analysisRuns                       BookAnalysisRun[]
  bookAnalysisBootstraps             BookAnalysisBootstrap[]
  memoryItems                        BookMemoryItem[]
  podcastProjects                    PodcastProject[]
  podcastEpisodes                    PodcastEpisode[]
  podcastGenerationRuns              PodcastGenerationRun[]
  podcastVoiceProfiles               PodcastVoiceProfile[]
  audioGenerationRuns                AudioGenerationRun[]
  podcastAudioPaidOutcomeQuarantines PodcastAudioPaidOutcomeQuarantine[]
  podcastAudioRevisions              PodcastAudioRevision[]
  shortVideoProjects                 ShortVideoProject[]
  shortVideoGenerationRuns           ShortVideoGenerationRun[]
  shortVideoRevisions                ShortVideoRevision[]
  providerConnections                ProviderConnection[]
  providerRoutes                     ProviderRouteBinding[]
  providerSnapshots                  ProviderExecutionSnapshot[]
  providerInvocations                ProviderInvocation[]
  providerInvocationAttempts         ProviderInvocationAttempt[]
  providerEmbeddingResults           ProviderEmbeddingResult[]
  providerTextResults                ProviderTextResult[]
  providerSpeechResults              ProviderSpeechResult[]
  providerUsageEvents                ProviderUsageEvent[]
  providerAuditEvents                ProviderAuditEvent[]
  cognitionStates                    UserCognitionState[]
  defaultForUsers                    User[]                              @relation("DefaultWorkspace")
  productEvents                      ProductEvent[]
  betaFeedback                       BetaFeedback[]
}

/// Closed Beta access is product access, never a second authentication identity.
model BetaParticipant {
  id             String                @id @default(cuid())
  userId         String                @unique
  cohort         String
  role           BetaParticipantRole   @default(TESTER)
  status         BetaParticipantStatus @default(ACTIVE)
  consentVersion String
  consentedAt    DateTime
  enrolledAt     DateTime              @default(now())
  withdrawnAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         ProductEvent[]
  feedback       BetaFeedback[]

  @@index([userId, status])
}

/// Only the SHA-256 digest of a high-entropy invite code is durable.
model BetaInvite {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  cohort           String
  expiresAt        DateTime
  revokedAt        DateTime?
  redeemedAt       DateTime?
  redeemedByUserId String?
  createdAt        DateTime  @default(now())
  redeemedByUser   User?     @relation("BetaInviteRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
}

model ProductEvent {
  id            String          @id @default(cuid())
  participantId String
  userId        String
  workspaceId   String
  eventName     String
  clientEventId String
  sessionId     String?
  entityType    String?
  entityId      String?
  route         String?
  properties    Json            @default("{}")
  occurredAt    DateTime        @default(now())
  participant   BetaParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([participantId, clientEventId])
  @@index([participantId, eventName, occurredAt])
  @@index([workspaceId, occurredAt])
}

model BetaFeedback {
  id            String                 @id @default(cuid())
  participantId String
  workspaceId   String?
  category      BetaFeedbackCategory
  dimension     BetaFeedbackDimension?
  rating        Int?
  message       String?
  entityType    String?
  entityId      String?
  route         String?
  status        BetaFeedbackStatus     @default(NEW)
  createdAt     DateTime               @default(now())
  reviewedAt    DateTime?
  participant   BetaParticipant        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  workspace     Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([participantId, createdAt])
}

model ProviderConnection {
  id                 String                      @id @default(cuid())
  workspaceId        String
  providerKey        String
  protocol           String
  displayName        String
  endpoint           String?
  region             String?
  configuration      Json                        @default("{}")
  status             ProviderConnectionStatus    @default(ACTIVE)
  health             ProviderConnectionHealth    @default(UNKNOWN)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  workspace          Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentialVersions ProviderCredentialVersion[]
  routeBindings      ProviderRouteBinding[]
  snapshots          ProviderExecutionSnapshot[]
  invocations        ProviderInvocation[]
  usageEvents        ProviderUsageEvent[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, displayName])
  @@index([workspaceId, status])
}

model ProviderCredentialVersion {
  id                String                      @id @default(cuid())
  workspaceId       String
  connectionId      String
  credentialVersion Int
  ciphertext        String
  iv                String
  authTag           String
  keyVersion        String
  displayHint       String?
  status            ProviderCredentialStatus    @default(ACTIVE)
  createdAt         DateTime                    @default(now())
  connection        ProviderConnection          @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  snapshots         ProviderExecutionSnapshot[]
  invocations       ProviderInvocation[]

  @@unique([id, workspaceId])
  @@unique([id, connectionId, workspaceId])
  @@unique([connectionId, credentialVersion])
  @@index([workspaceId, connectionId, status])
}

model ProviderRouteBinding {
  id            String             @id @default(cuid())
  workspaceId   String
  routeSlot     String
  connectionId  String
  modelId       String
  configuration Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection    ProviderConnection @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, routeSlot])
  @@index([connectionId])
}

model ProviderExecutionSnapshot {
  id                        String                            @id @default(cuid())
  workspaceId               String
  routeSlot                 String
  providerKey               String
  protocol                  String
  modelId                   String
  connectionId              String?
  credentialVersionId       String?
  endpoint                  String?
  region                    String?
  capability                Json
  configuration             Json                              @default("{}")
  configurationHash         String
  adapterVersion            String
  promptVersion             String?
  schemaVersion             String?
  pipelineVersion           String?
  correlationId             String
  outcomeRecoveryCapability ProviderOutcomeRecoveryCapability @default(NONE)
  createdAt                 DateTime                          @default(now())
  workspace                 Workspace                         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection                ProviderConnection?               @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  credentialVersion         ProviderCredentialVersion?        @relation(fields: [credentialVersionId, connectionId, workspaceId], references: [id, connectionId, workspaceId], onDelete: Restrict)
  invocations               ProviderInvocation[]
  embeddingResults          ProviderEmbeddingResult[]
  textResults               ProviderTextResult[]
  speechResults             ProviderSpeechResult[]

  @@unique([id, workspaceId])
  @@index([workspaceId, routeSlot, createdAt])
}

model ProviderInvocation {
  id                     String                              @id @default(cuid())
  workspaceId            String
  snapshotId             String
  connectionId           String?
  credentialVersionId    String?
  providerKey            String
  protocol               String
  modelId                String
  routeSlot              String
  idempotencyKey         String
  requestFingerprint     String
  correlationId          String
  status                 ProviderInvocationStatus            @default(PENDING)
  claimToken             String?
  claimOwner             String?
  claimExpiresAt         DateTime?
  createdAt              DateTime                            @default(now())
  completedAt            DateTime?
  workspace              Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot               ProviderExecutionSnapshot           @relation(fields: [snapshotId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  connection             ProviderConnection?                 @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  credentialVersion      ProviderCredentialVersion?          @relation(fields: [credentialVersionId, connectionId, workspaceId], references: [id, connectionId, workspaceId], onDelete: Restrict)
  usageEvents            ProviderUsageEvent[]
  attempts               ProviderInvocationAttempt[]
  embeddingResult        ProviderEmbeddingResult?
  textResult             ProviderTextResult?
  speechResult           ProviderSpeechResult?
  paidOutcomeQuarantines PodcastAudioPaidOutcomeQuarantine[]

  @@unique([workspaceId, idempotencyKey])
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, snapshotId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, claimExpiresAt])
}

model ProviderInvocationAttempt {
  id                     String                              @id @default(cuid())
  workspaceId            String
  invocationId           String
  attemptNumber          Int
  status                 ProviderInvocationAttemptStatus     @default(RUNNING)
  failureCode            String?
  remoteRequestId        String?
  latencyMs              Int?
  createdAt              DateTime                            @default(now())
  startedAt              DateTime                            @default(now())
  completedAt            DateTime?
  workspace              Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invocation             ProviderInvocation                  @relation(fields: [invocationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  usageEvents            ProviderUsageEvent[]
  embeddingResult        ProviderEmbeddingResult?
  textResult             ProviderTextResult?
  speechResult           ProviderSpeechResult?
  paidOutcomeQuarantines PodcastAudioPaidOutcomeQuarantine[]

  @@unique([id, invocationId, workspaceId])
  @@unique([invocationId, attemptNumber])
  @@index([workspaceId, invocationId])
}

model ProviderEmbeddingResult {
  id                  String                    @id @default(cuid())
  workspaceId         String
  invocationId        String                    @unique
  attemptId           String                    @unique
  snapshotId          String
  ciphertext          String?
  iv                  String?
  authTag             String?
  keyVersion          String?
  vectorCount         Int
  dimensions          Int
  createdAt           DateTime                  @default(now())
  consumedAt          DateTime?
  purgedAt            DateTime?
  consumerKind        String?
  consumerKey         String?
  consumerFingerprint String?
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invocation          ProviderInvocation        @relation(fields: [invocationId, workspaceId, snapshotId], references: [id, workspaceId, snapshotId], onDelete: Cascade)
  attempt             ProviderInvocationAttempt @relation(fields: [attemptId, invocationId, workspaceId], references: [id, invocationId, workspaceId], onDelete: Cascade)
  snapshot            ProviderExecutionSnapshot @relation(fields: [snapshotId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@unique([invocationId, workspaceId])
  @@unique([invocationId, workspaceId, snapshotId])
  @@unique([attemptId, invocationId, workspaceId])
  @@index([workspaceId, invocationId])
  @@index([workspaceId, consumedAt])
}

model ProviderTextResult {
  id                  String                    @id @default(cuid())
  workspaceId         String
  invocationId        String                    @unique
  attemptId           String                    @unique
  snapshotId          String
  ciphertext          String?
  iv                  String?
  authTag             String?
  keyVersion          String?
  createdAt           DateTime                  @default(now())
  consumedAt          DateTime?
  purgedAt            DateTime?
  consumerKind        String?
  consumerKey         String?
  consumerFingerprint String?
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invocation          ProviderInvocation        @relation(fields: [invocationId, workspaceId, snapshotId], references: [id, workspaceId, snapshotId], onDelete: Cascade)
  attempt             ProviderInvocationAttempt @relation(fields: [attemptId, invocationId, workspaceId], references: [id, invocationId, workspaceId], onDelete: Cascade)
  snapshot            ProviderExecutionSnapshot @relation(fields: [snapshotId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@unique([invocationId, workspaceId])
  @@unique([invocationId, workspaceId, snapshotId])
  @@unique([attemptId, invocationId, workspaceId])
  @@index([workspaceId, invocationId])
  @@index([workspaceId, consumedAt])
}

model ProviderSpeechResult {
  id                  String                    @id @default(cuid())
  workspaceId         String
  invocationId        String                    @unique
  attemptId           String                    @unique
  snapshotId          String
  ciphertext          String?
  iv                  String?
  authTag             String?
  keyVersion          String?
  byteLength          Int
  sha256              String
  mediaType           String
  format              String
  sampleRate          Int
  channels            Int
  durationMs          Int?
  createdAt           DateTime                  @default(now())
  consumedAt          DateTime?
  purgedAt            DateTime?
  consumerKind        String?
  consumerKey         String?
  consumerFingerprint String?
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invocation          ProviderInvocation        @relation(fields: [invocationId, workspaceId, snapshotId], references: [id, workspaceId, snapshotId], onDelete: Cascade)
  attempt             ProviderInvocationAttempt @relation(fields: [attemptId, invocationId, workspaceId], references: [id, invocationId, workspaceId], onDelete: Cascade)
  snapshot            ProviderExecutionSnapshot @relation(fields: [snapshotId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@unique([invocationId, workspaceId])
  @@unique([invocationId, workspaceId, snapshotId])
  @@unique([attemptId, invocationId, workspaceId])
  @@index([workspaceId, invocationId])
  @@index([workspaceId, consumedAt])
}

model ProviderUsageEvent {
  id                    String                    @id @default(cuid())
  workspaceId           String
  invocationId          String
  attemptId             String
  attemptNumber         Int
  providerKey           String
  connectionId          String?
  modelId               String
  capability            String
  routeSlot             String
  status                ProviderUsageStatus
  inputTokens           Int?
  cachedInputTokens     Int?
  outputTokens          Int?
  embeddingInputTokens  Int?
  speechInputCharacters Int?
  audioDurationMs       Int?
  latencyMs             Int?
  remoteRequestId       String?
  metadata              Json?
  createdAt             DateTime                  @default(now())
  workspace             Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invocation            ProviderInvocation        @relation(fields: [invocationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  attempt               ProviderInvocationAttempt @relation(fields: [attemptId, invocationId, workspaceId], references: [id, invocationId, workspaceId], onDelete: Restrict)
  connection            ProviderConnection?       @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, invocationId, createdAt])
}

model ProviderAuditEvent {
  id          String              @id @default(cuid())
  workspaceId String
  actorUserId String
  action      ProviderAuditAction
  targetType  String
  targetId    String
  metadata    Json                @default("{}")
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model WorkspaceMember {
  workspaceId            String
  userId                 String
  role                   WorkspaceRole
  createdAt              DateTime                   @default(now())
  workspace              Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  thinkingSessions       ThinkingSession[]
  teachBackAttempts      TeachBackAttempt[]
  cognitionReviewStates  UserCognitionReviewState[]
  cognitionReviewEvents  UserCognitionReviewEvent[]
  bookAnalysisBootstraps BookAnalysisBootstrap[]

  @@id([workspaceId, userId])
}

model Project {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
