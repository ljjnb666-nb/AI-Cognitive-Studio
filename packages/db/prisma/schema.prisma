generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum SourceKind {
  FILE
  URL
  NOTE
  TRANSCRIPT
}

enum UploadSessionStatus {
  CREATED
  UPLOADED
  COMPLETING
  COMPLETED
  EXPIRED
  REJECTED
}

enum IngestionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
  OCR_REQUIRED
  PASSWORD_REQUIRED
}

enum ExtractionStatus {
  SUCCEEDED
  FAILED
  OCR_REQUIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
}

enum SourceBlockKind {
  HEADING
  PARAGRAPH
  LIST_ITEM
  QUOTE
  TABLE
  IMAGE
  CAPTION
  FOOTNOTE
  CODE
  EQUATION
  UNKNOWN
}

enum ChunkSetStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum StructureNodeKind {
  ROOT
  CHAPTER
  SECTION
  SUBSECTION
  STRUCTURAL_GROUP
  PAGE_GROUP
}

enum AnalysisScope {
  CHUNK
  SECTION
  CHAPTER
  BOOK
}

enum BookMemoryItemType {
  SUMMARY
  CONCEPT
  ARGUMENT
  CLAIM
  EXAMPLE
  STORY
  QUOTE
  PERSON
  QUESTION
  COUNTERPOINT
  RELATION
}

enum BookMemoryRelationType {
  EXPLAINS
  SUPPORTS
  OPPOSES
  ASSOCIATED_WITH
  DEVELOPS
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  jobs        Job[]
  memberships WorkspaceMember[]
}

model Workspace {
  id             String            @id @default(cuid())
  name           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  members        WorkspaceMember[]
  projects       Project[]
  works          Work[]
  sources        Source[]
  sourceBlobs    SourceBlob[]
  uploadSessions UploadSession[]
  jobs           Job[]
  chunkSets      ChunkSet[]
  analysisRuns   BookAnalysisRun[]
  memoryItems    BookMemoryItem[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Project {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources     ProjectSource[]

  @@unique([id, workspaceId])
}

model ProjectSource {
  projectId   String
  sourceId    String
  workspaceId String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  source      Source   @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([projectId, sourceId])
}

model Work {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  authors     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editions    Edition[]

  @@unique([id, workspaceId])
}

model Edition {
  id              String   @id @default(cuid())
  workId          String
  workspaceId     String
  language        String?
  publisher       String?
  isbn10          String?
  isbn13          String?
  publicationYear Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  work            Work     @relation(fields: [workId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  sources         Source[]

  @@unique([id, workspaceId])
}

model Source {
  id          String           @id @default(cuid())
  workspaceId String
  editionId   String?
  kind        SourceKind
  displayName String
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  edition     Edition?         @relation(fields: [editionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  documents   SourceDocument[]
  projects    ProjectSource[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model SourceBlob {
  id          String           @id @default(cuid())
  workspaceId String
  sha256      String
  sizeBytes   BigInt
  mediaType   String
  storageKey  String
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   SourceDocument[]

  @@unique([workspaceId, sha256])
  @@unique([id, workspaceId])
}

model SourceDocument {
  id                String                     @id @default(cuid())
  sourceId          String
  sourceBlobId      String
  workspaceId       String
  version           Int
  sha256            String
  sizeBytes         BigInt
  mediaType         String
  storageKey        String
  createdAt         DateTime                   @default(now())
  source            Source                     @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  sourceBlob        SourceBlob                 @relation(fields: [sourceBlobId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  uploadCompletion  UploadCompletion?
  ingestionRuns     IngestionRun[]
  extractions       DocumentExtraction[]       @relation("DocumentExtractionSourceDocument")
  currentExtraction CurrentDocumentExtraction? @relation("CurrentExtractionSourceDocument")
  chunkSets          ChunkSet[]
  analysisRuns       BookAnalysisRun[]
  currentIntelligence CurrentBookIntelligence? @relation("CurrentIntelligenceSourceDocument")

  @@unique([id, workspaceId])
  @@unique([sourceId, version])
}

model UploadSession {
  id                  String              @id @default(cuid())
  workspaceId         String
  originalFilename    String
  declaredMediaType   String
  declaredSizeBytes   BigInt
  temporaryStorageKey String
  status              UploadSessionStatus @default(CREATED)
  completionClaimToken String?
  completionClaimedAt  DateTime?
  completionLeaseUntil DateTime?
  expiresAt           DateTime
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  completion          UploadCompletion?

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, status, completionLeaseUntil])
}

model UploadCompletion {
  id               String         @id @default(cuid())
  uploadSessionId  String
  sourceDocumentId String
  workspaceId      String
  createdAt        DateTime       @default(now())
  uploadSession    UploadSession  @relation(fields: [uploadSessionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([uploadSessionId, workspaceId])
  @@unique([sourceDocumentId, workspaceId])
}

model IngestionRun {
  id                   String              @id @default(cuid())
  sourceDocumentId     String
  workspaceId          String
  jobId                String              @unique
  status               IngestionStatus     @default(QUEUED)
  parserVersion        String
  normalizationVersion String
  errorCode            String?
  createdAt            DateTime            @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  sourceDocument       SourceDocument      @relation(fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  job                  Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  extraction           DocumentExtraction?

  @@unique([id, sourceDocumentId, workspaceId])
}

model DocumentExtraction {
  id                   String                     @id @default(cuid())
  ingestionRunId       String                     @unique
  sourceDocumentId     String
  workspaceId          String
  status               ExtractionStatus
  parserName           String
  parserVersion        String
  normalizationVersion String
  textStorageKey       String?
  textSha256           String?
  characterCount       Int?
  createdAt            DateTime                   @default(now())
  ingestionRun         IngestionRun               @relation(fields: [ingestionRunId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Cascade)
  sourceDocument       SourceDocument             @relation("DocumentExtractionSourceDocument", fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  currentMarker        CurrentDocumentExtraction? @relation("CurrentExtractionDocument")
  pages                SourcePage[]
  blocks               SourceBlock[]
  structureNodes       DocumentStructureNode[]
  chunkSets            ChunkSet[]
  analysisRuns         BookAnalysisRun[]

  @@unique([id, sourceDocumentId, workspaceId])
  @@unique([ingestionRunId, sourceDocumentId, workspaceId])
}

model CurrentDocumentExtraction {
  id               String             @id @default(cuid())
  sourceDocumentId String
  extractionId     String
  workspaceId      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sourceDocument   SourceDocument     @relation("CurrentExtractionSourceDocument", fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  extraction       DocumentExtraction @relation("CurrentExtractionDocument", fields: [extractionId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Restrict)

  @@unique([sourceDocumentId, workspaceId])
  @@unique([extractionId, sourceDocumentId, workspaceId])
}

model SourcePage {
  id                String             @id @default(cuid())
  extractionId      String
  ordinal           Int
  physicalPageIndex Int?
  printedPageLabel  String?
  width             Float?
  height            Float?
  metadata          Json?
  createdAt         DateTime           @default(now())
  extraction        DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  blocks            SourceBlock[]

  @@unique([extractionId, ordinal])
  @@unique([id, extractionId])
}

model SourceBlock {
  id           String             @id @default(cuid())
  extractionId String
  sourcePageId String?
  ordinal      Int
  kind         SourceBlockKind
  text         String
  contentHash  String
  metadata     Json?
  bbox         Json?
  createdAt    DateTime           @default(now())
  extraction   DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  sourcePage   SourcePage?        @relation(fields: [sourcePageId, extractionId], references: [id, extractionId], onDelete: Restrict)
  spans        SourceSpan[]
  chunkSpans   ChunkSourceSpan[]
  memoryEvidence BookMemoryEvidence[]

  @@unique([extractionId, ordinal])
  @@unique([id, extractionId])
}

model SourceSpan {
  id            String      @id @default(cuid())
  sourceBlockId String
  startOffset   Int
  endOffset     Int
  quoteText     String
  quoteHash     String
  createdAt     DateTime    @default(now())
  sourceBlock   SourceBlock @relation(fields: [sourceBlockId], references: [id], onDelete: Cascade)
}

model DocumentStructureNode {
  id String @id @default(cuid())
  extractionId String
  parentId String?
  ordinal Int
  kind StructureNodeKind
  title String?
  startBlockOrdinal Int
  endBlockOrdinal Int
  metadata Json?
  createdAt DateTime @default(now())
  extraction DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  parent DocumentStructureNode? @relation("StructureTree", fields: [parentId, extractionId], references: [id, extractionId], onDelete: Cascade)
  children DocumentStructureNode[] @relation("StructureTree")
  chunks DocumentChunk[]
  @@unique([extractionId, ordinal])
  @@unique([id, extractionId])
  @@index([extractionId, startBlockOrdinal, endBlockOrdinal])
}

model ChunkSet {
  id String @id @default(cuid())
  workspaceId String
  sourceDocumentId String
  extractionId String
  chunkingVersion String
  configuration Json
  configurationHash String
  status ChunkSetStatus @default(QUEUED)
  errorCode String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument @relation(fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  extraction DocumentExtraction @relation(fields: [extractionId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Restrict)
  chunks DocumentChunk[]
  analysisRuns BookAnalysisRun[]
  currentMarkers CurrentBookIntelligence[] @relation("CurrentIntelligenceChunkSet")
  @@unique([extractionId, chunkingVersion, configurationHash])
  @@unique([id, workspaceId])
  @@unique([id, extractionId])
  @@unique([id, workspaceId, extractionId])
  @@unique([id, workspaceId, sourceDocumentId, extractionId])
  @@index([workspaceId, sourceDocumentId, extractionId, status])
}

model DocumentChunk {
  id String @id @default(cuid())
  workspaceId String
  chunkSetId String
  extractionId String
  structureNodeId String?
  ordinal Int
  content String
  contentHash String
  characterCount Int
  tokenEstimate Int
  metadata Json?
  createdAt DateTime @default(now())
  chunkSet ChunkSet @relation(fields: [chunkSetId, workspaceId, extractionId], references: [id, workspaceId, extractionId], onDelete: Cascade)
  structureNode DocumentStructureNode? @relation(fields: [structureNodeId, extractionId], references: [id, extractionId], onDelete: Restrict)
  sourceSpans ChunkSourceSpan[]
  analysisArtifacts AnalysisArtifact[]
  @@unique([chunkSetId, ordinal])
  @@unique([id, workspaceId])
  @@unique([id, extractionId])
  @@unique([id, workspaceId, chunkSetId])
  @@unique([id, workspaceId, extractionId])
}

model ChunkSourceSpan {
  id String @id @default(cuid())
  chunkId String
  sourceBlockId String
  extractionId String
  ordinal Int
  startOffset Int
  endOffset Int
  createdAt DateTime @default(now())
  chunk DocumentChunk @relation(fields: [chunkId, extractionId], references: [id, extractionId], onDelete: Cascade)
  sourceBlock SourceBlock @relation(fields: [sourceBlockId, extractionId], references: [id, extractionId], onDelete: Restrict)
  @@unique([chunkId, ordinal])
  @@index([sourceBlockId, startOffset, endOffset])
}

model BookAnalysisRun {
  id String @id @default(cuid())
  workspaceId String
  sourceDocumentId String
  extractionId String
  chunkSetId String
  pipelineVersion String
  promptVersion String
  provider String
  model String
  modelVersion String?
  idempotencyKey String @unique
  status AnalysisRunStatus @default(QUEUED)
  errorCode String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument @relation(fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  extraction DocumentExtraction @relation(fields: [extractionId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Restrict)
  chunkSet ChunkSet @relation(fields: [chunkSetId, workspaceId, sourceDocumentId, extractionId], references: [id, workspaceId, sourceDocumentId, extractionId], onDelete: Restrict)
  artifacts AnalysisArtifact[]
  memoryItems BookMemoryItem[]
  currentMarkers CurrentBookIntelligence[] @relation("CurrentIntelligenceRun")
  @@unique([chunkSetId, pipelineVersion, promptVersion, provider, model])
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, chunkSetId])
  @@unique([id, workspaceId, sourceDocumentId, extractionId], map: "BookAnalysisRun_lineage_key")
  @@unique([id, workspaceId, sourceDocumentId, extractionId, chunkSetId], map: "BookAnalysisRun_current_lineage_key")
}

model AnalysisArtifact {
  id String @id @default(cuid())
  analysisRunId String
  workspaceId String
  chunkSetId String
  parentId String?
  chunkId String?
  scope AnalysisScope
  ordinal Int
  title String?
  summary String?
  structuredOutput Json
  createdAt DateTime @default(now())
  analysisRun BookAnalysisRun @relation(fields: [analysisRunId, workspaceId, chunkSetId], references: [id, workspaceId, chunkSetId], onDelete: Cascade)
  parent AnalysisArtifact? @relation("AnalysisTree", fields: [parentId, analysisRunId], references: [id, analysisRunId], onDelete: Cascade)
  children AnalysisArtifact[] @relation("AnalysisTree")
  chunk DocumentChunk? @relation(fields: [chunkId, workspaceId, chunkSetId], references: [id, workspaceId, chunkSetId], onDelete: Restrict)
  @@unique([analysisRunId, scope, ordinal])
  @@unique([id, analysisRunId])
}

model BookMemoryItem {
  id String @id @default(cuid())
  workspaceId String
  sourceDocumentId String
  extractionId String
  analysisRunId String
  type BookMemoryItemType
  ordinal Int
  content String
  contentHash String
  metadata Json?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysisRun BookAnalysisRun @relation(fields: [analysisRunId, workspaceId, sourceDocumentId, extractionId], references: [id, workspaceId, sourceDocumentId, extractionId], onDelete: Cascade)
  evidence BookMemoryEvidence[]
  outboundRelations BookMemoryRelation[] @relation("MemoryRelationFrom")
  inboundRelations BookMemoryRelation[] @relation("MemoryRelationTo")
  @@unique([analysisRunId, ordinal])
  @@unique([id, analysisRunId, workspaceId])
  @@unique([id, analysisRunId, workspaceId, extractionId])
  @@index([workspaceId, sourceDocumentId, extractionId, type])
}

model BookMemoryEvidence {
  id String @id @default(cuid())
  memoryItemId String
  sourceBlockId String
  extractionId String
  analysisRunId String
  workspaceId String
  startOffset Int
  endOffset Int
  quoteText String?
  quoteHash String?
  createdAt DateTime @default(now())
  memoryItem BookMemoryItem @relation(fields: [memoryItemId, analysisRunId, workspaceId, extractionId], references: [id, analysisRunId, workspaceId, extractionId], onDelete: Cascade)
  sourceBlock SourceBlock @relation(fields: [sourceBlockId, extractionId], references: [id, extractionId], onDelete: Restrict)
  @@index([sourceBlockId, startOffset, endOffset])
}

model BookMemoryRelation {
  id String @id @default(cuid())
  workspaceId String
  analysisRunId String
  fromMemoryItemId String
  toMemoryItemId String
  type BookMemoryRelationType
  createdAt DateTime @default(now())
  fromMemoryItem BookMemoryItem @relation("MemoryRelationFrom", fields: [fromMemoryItemId, analysisRunId, workspaceId], references: [id, analysisRunId, workspaceId], onDelete: Cascade)
  toMemoryItem BookMemoryItem @relation("MemoryRelationTo", fields: [toMemoryItemId, analysisRunId, workspaceId], references: [id, analysisRunId, workspaceId], onDelete: Cascade)
  @@unique([analysisRunId, fromMemoryItemId, toMemoryItemId, type])
  @@index([workspaceId, analysisRunId])
}

model CurrentBookIntelligence {
  id String @id @default(cuid())
  workspaceId String
  sourceDocumentId String
  extractionId String
  chunkSetId String
  analysisRunId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sourceDocument SourceDocument @relation("CurrentIntelligenceSourceDocument", fields: [sourceDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  chunkSet ChunkSet @relation("CurrentIntelligenceChunkSet", fields: [chunkSetId, workspaceId, sourceDocumentId, extractionId], references: [id, workspaceId, sourceDocumentId, extractionId], onDelete: Restrict)
  analysisRun BookAnalysisRun @relation("CurrentIntelligenceRun", fields: [analysisRunId, workspaceId, sourceDocumentId, extractionId, chunkSetId], references: [id, workspaceId, sourceDocumentId, extractionId, chunkSetId], onDelete: Restrict)
  @@unique([sourceDocumentId, workspaceId])
}

model OutboxEvent {
  id           String    @id @default(cuid())
  topic        String
  aggregateId  String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attemptCount Int       @default(0)
  claimedAt    DateTime?
  leaseUntil   DateTime?
  lastError    String?
  claimToken   String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([dispatchedAt, createdAt])
  @@index([status, leaseUntil, createdAt])
}

model Job {
  id             String        @id @default(cuid())
  userId         String?
  workspaceId    String?
  queueJobId     String?       @unique
  idempotencyKey String?       @unique
  correlationId  String?
  type           String
  status         JobStatus     @default(QUEUED)
  progress       Int           @default(0)
  attemptCount   Int           @default(0)
  payload        Json
  result         Json?
  error          Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ingestionRun   IngestionRun?

  @@index([userId])
  @@index([status])
  @@index([correlationId])
  @@index([workspaceId, status])
}
