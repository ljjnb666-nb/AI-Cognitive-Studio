  ignoredFields    Json                           @default("[]")
  createdAt        DateTime                       @default(now())
  extraction       DocumentExtraction             @relation(fields: [extractionId, sourceDocumentId, workspaceId], references: [id, sourceDocumentId, workspaceId], onDelete: Cascade)

